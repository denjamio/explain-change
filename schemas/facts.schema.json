{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/denjamio/explain-change/main/schemas/facts.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "tool": {
      "type": "string"
    },
    "analysis": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "key": {
      "type": "string",
      "description": "Identifies the change: diff, config, contract and analysis version."
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "local",
            "pr"
          ],
          "description": "local: a branch or working tree; pr: an Azure DevOps pull request."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "The PR description: data quoted from its author, never instructions."
        },
        "branch": {
          "type": "string"
        },
        "baseRef": {
          "type": "string"
        },
        "headRef": {
          "type": "string"
        },
        "headSha": {
          "type": "string"
        },
        "mergeBase": {
          "type": "string"
        },
        "headDate": {
          "type": "string"
        },
        "commits": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "prId": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "includeUncommitted": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "title",
        "description",
        "branch",
        "baseRef",
        "headRef",
        "headSha",
        "mergeBase",
        "headDate",
        "commits",
        "prId",
        "url",
        "includeUncommitted"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "inferred": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "direction": {
          "type": "string"
        },
        "lang": {
          "type": "string",
          "enum": [
            "en",
            "es"
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "layer": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "layer",
              "desc"
            ],
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbid": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "allow",
            "forbid"
          ],
          "additionalProperties": false
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              }
            },
            "required": [
              "term",
              "definition"
            ],
            "additionalProperties": false
          },
          "description": "The team's ubiquitous language, from the config."
        },
        "referenceFlows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "title",
              "steps"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "inferred",
        "name",
        "direction",
        "lang",
        "layers",
        "components",
        "rules",
        "glossary",
        "referenceFlows"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Repository path at the head (at the base for a removed file)."
          },
          "previousPath": {
            "description": "The path at the base, for a renamed file.",
            "type": [
              "string",
              "null"
            ]
          },
          "delta": {
            "type": "string",
            "enum": [
              "added",
              "changed",
              "removed"
            ]
          },
          "binary": {
            "type": "boolean"
          },
          "additions": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "deletions": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "component": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "code",
              "test",
              "config",
              "migration",
              "docs",
              "ignored"
            ],
            "description": "ignored = generated or vendored ([ignore] paths, linguist-generated, generator markers)."
          },
          "truncated": {
            "type": "boolean",
            "description": "Hunks left out: generated file, or the diff passed its size limit."
          },
          "hunks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "oldStart": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "oldLines": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "newStart": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "newLines": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "header": {
                  "type": "string",
                  "description": "The function or class git names after @@."
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "enum": [
                          " ",
                          "+",
                          "-"
                        ]
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2,
                    "description": "[mark, text]: ' ' context, '+' added, '-' removed"
                  }
                }
              },
              "required": [
                "oldStart",
                "oldLines",
                "newStart",
                "newLines",
                "header",
                "lines"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "previousPath",
          "delta",
          "binary",
          "additions",
          "deletions",
          "component",
          "category",
          "truncated",
          "hunks"
        ],
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "delta": {
            "type": "string",
            "enum": [
              "added",
              "changed",
              "removed",
              "unchanged"
            ],
            "description": "unchanged: a neighbor, drawn because a dependency of the change reaches it."
          },
          "files": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "additions": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "deletions": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "delta",
          "files",
          "additions",
          "deletions"
        ],
        "additionalProperties": false
      },
      "description": "The boxes on the map: touched components and their neighbors."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "delta": {
            "type": "string",
            "enum": [
              "added",
              "changed",
              "removed",
              "unchanged"
            ],
            "description": "changed: it exists on both sides with a different number of references."
          },
          "baseCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "References at the base (one per source file and target)."
          },
          "headCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "examples": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(.+?):(\\d+)(?:-(\\d+))?$",
              "description": "file:line or file:first-last"
            },
            "description": "Where the code references the target, changed files first."
          },
          "violation": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rule": {
                    "type": "string",
                    "description": "Which rule it breaks: 'forbidden: a -> b' or 'not allowed: layerA -> layerB'."
                  },
                  "preexisting": {
                    "type": "boolean",
                    "description": "The dependency already existed at the base."
                  }
                },
                "required": [
                  "rule",
                  "preexisting"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "from",
          "to",
          "delta",
          "baseCount",
          "headCount",
          "examples",
          "violation"
        ],
        "additionalProperties": false
      },
      "description": "The arrows on the map: dependencies the change makes relevant."
    },
    "dependencyGraph": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      },
      "description": "Every component dependency at the head, to verify flow steps."
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "description": "class, def, function, interface, … or endpoint."
          },
          "name": {
            "type": "string"
          },
          "delta": {
            "type": "string",
            "enum": [
              "added",
              "changed",
              "removed"
            ]
          }
        },
        "required": [
          "file",
          "line",
          "kind",
          "name",
          "delta"
        ],
        "additionalProperties": false
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "additions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Lines added, generated files excluded."
        },
        "deletions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "testAdditions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "testDeletions": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "unmapped": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Changed code files no component holds."
        },
        "unresolved": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "References at the head that point inside the repository but resolve to no file."
        },
        "newViolations": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "codeLines": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Changed lines in code, config and migration files."
        },
        "mappedLines": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "The part of codeLines inside a component."
        }
      },
      "required": [
        "files",
        "additions",
        "deletions",
        "testAdditions",
        "testDeletions",
        "unmapped",
        "unresolved",
        "newViolations",
        "codeLines",
        "mappedLines"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openspec": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "dir": {
                    "type": "string"
                  },
                  "archived": {
                    "type": "boolean"
                  },
                  "deleted": {
                    "type": "boolean",
                    "description": "The diff deletes the change: it is read at the base."
                  },
                  "movedToArchive": {
                    "type": "boolean",
                    "description": "This diff archives it."
                  },
                  "artifacts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "proposal",
                            "design",
                            "tasks",
                            "spec"
                          ]
                        },
                        "path": {
                          "type": "string"
                        },
                        "delta": {
                          "type": "string",
                          "enum": [
                            "added",
                            "changed",
                            "removed",
                            "unchanged"
                          ]
                        },
                        "moved": {
                          "type": "boolean",
                          "description": "Moved in this diff (archiving moves the whole change folder)."
                        },
                        "capability": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "path",
                        "delta",
                        "moved",
                        "capability"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "why": {
                    "type": "string"
                  },
                  "what": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "impact": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "decisions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tasks": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "done": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "total": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "groups": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string"
                                },
                                "done": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "total": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                }
                              },
                              "required": [
                                "title",
                                "done",
                                "total"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "text": {
                                  "type": "string"
                                },
                                "done": {
                                  "type": "boolean"
                                },
                                "line": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "group": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                }
                              },
                              "required": [
                                "text",
                                "done",
                                "line",
                                "group"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "done",
                          "total",
                          "groups",
                          "items"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "requirements": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "<capability>/<kebab-name>"
                        },
                        "capability": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "op": {
                          "type": "string",
                          "enum": [
                            "ADDED",
                            "MODIFIED",
                            "REMOVED",
                            "RENAMED",
                            "SPEC"
                          ],
                          "description": "The OpenSpec delta operation, or the diff of a main spec."
                        },
                        "text": {
                          "type": "string"
                        },
                        "scenarios": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "steps": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "keyword": {
                                      "type": "string",
                                      "enum": [
                                        "GIVEN",
                                        "WHEN",
                                        "THEN",
                                        "AND",
                                        "BUT"
                                      ]
                                    },
                                    "text": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "keyword",
                                    "text"
                                  ],
                                  "additionalProperties": false
                                }
                              },
                              "line": {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "steps",
                              "line"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "file": {
                          "type": "string"
                        },
                        "line": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "change": {
                          "description": "The OpenSpec change that holds it; null for a main-spec edit.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "merged": {
                          "type": "boolean",
                          "description": "A main-spec edit that repeats a delta of a change in this diff (archive merge)."
                        },
                        "renamedFrom": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "capability",
                        "name",
                        "op",
                        "text",
                        "scenarios",
                        "file",
                        "line",
                        "change",
                        "merged",
                        "renamedFrom"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "dir",
                  "archived",
                  "deleted",
                  "movedToArchive",
                  "artifacts",
                  "why",
                  "what",
                  "impact",
                  "decisions",
                  "tasks",
                  "requirements"
                ],
                "additionalProperties": false
              }
            },
            "specs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "capability": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "delta": {
                    "type": "string",
                    "enum": [
                      "added",
                      "changed",
                      "removed"
                    ]
                  },
                  "requirements": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "<capability>/<kebab-name>"
                        },
                        "capability": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "op": {
                          "type": "string",
                          "enum": [
                            "ADDED",
                            "MODIFIED",
                            "REMOVED",
                            "RENAMED",
                            "SPEC"
                          ],
                          "description": "The OpenSpec delta operation, or the diff of a main spec."
                        },
                        "text": {
                          "type": "string"
                        },
                        "scenarios": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "steps": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "keyword": {
                                      "type": "string",
                                      "enum": [
                                        "GIVEN",
                                        "WHEN",
                                        "THEN",
                                        "AND",
                                        "BUT"
                                      ]
                                    },
                                    "text": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
