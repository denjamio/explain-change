{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "explain-change/insight.schema.json",
  "title": "explain-change insight (v1)",
  "description": "What the agent writes. `explain-change validate` also checks cross-references: component ids of this change, files and line ranges inside hunks, and key freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tldr",
    "intent"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "key": {
      "type": "string",
      "description": "Change key from the digest; a different key marks the insight as stale."
    },
    "lang": {
      "enum": [
        "en",
        "es"
      ]
    },
    "tldr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "story": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "description": "Guided tour over the diagrams. One step = one change, headline first. The camera moves to `stage` and lights `focus`; everything else dims.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "body"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "maxLength": 60,
            "description": "The thing and what happened to it (added, removed, now, moved)."
          },
          "body": {
            "type": "string",
            "maxLength": 160,
            "description": "What behaves differently now; not a description of the code."
          },
          "stage": {
            "type": "string",
            "pattern": "^(architecture|spec|data|flow:[a-z0-9]+(-[a-z0-9]+)*)$",
            "default": "architecture"
          },
          "focus": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            },
            "description": "Ids on the stage: component ids; on a flow also step numbers '#2'; on spec requirement ids."
          },
          "code": {
            "type": "string",
            "pattern": "^.+:\\d+(-\\d+)?$",
            "description": "Optional file:a-b inside a hunk, shown beside the step."
          }
        }
      }
    },
    "hero": {
      "type": "array",
      "maxItems": 2,
      "description": "The dependency (drawn edge) the change is really about.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "description": "One entry per changed component (every one is required).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "why"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "why": {
            "type": "string",
            "maxLength": 200
          },
          "alternative": {
            "type": "string",
            "maxLength": 140
          },
          "evidence": {
            "type": "string",
            "pattern": "^.+:\\d+(-\\d+)?$"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "msg",
                "status"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "msg": {
                  "type": "string",
                  "maxLength": 50
                },
                "status": {
                  "enum": [
                    "same",
                    "changed",
                    "new",
                    "removed"
                  ]
                },
                "data": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "description": "What travels on this step.",
                  "properties": {
                    "type": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "fields": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "string",
                        "maxLength": 60,
                        "description": "'+email: string' added, '-fax' removed, '~total: number' changed, 'id: string' unchanged."
                      }
                    }
                  }
                }
              }
            }
          },
          "scenario": {
            "type": "string",
            "pattern": "^[^#]+#[a-z0-9-]+$",
            "description": "OpenSpec scenario this flow realises: <requirement-id>#<scenario-id>."
          }
        }
      }
    },
    "data_model": {
      "type": "object",
      "additionalProperties": false,
      "description": "Entities and relations the change touches (models, tables, schemas, migrations).",
      "properties": {
        "entities": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "change"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "maxLength": 40
              },
              "change": {
                "enum": [
                  "added",
                  "changed",
                  "removed",
                  "same"
                ]
              },
              "component": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "maxLength": 60,
                  "description": "'+email: string' added, '-fax' removed, '~total: number' changed, 'id: string' unchanged."
                }
              },
              "evidence": {
                "type": "string",
                "pattern": "^.+:\\d+(-\\d+)?$",
                "description": "Model or migration hunk; required unless change is 'same'."
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "change"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "maxLength": 30
              },
              "change": {
                "enum": [
                  "added",
                  "changed",
                  "removed",
                  "same"
                ]
              }
            }
          }
        }
      }
    },
    "spec": {
      "type": "array",
      "maxItems": 80,
      "description": "OpenSpec traceability: one entry per ADDED/MODIFIED requirement of the change (REMOVED optional).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "req",
          "status"
        ],
        "properties": {
          "req": {
            "type": "string",
            "description": "Requirement id from the digest: <capability>/<requirement-slug>."
          },
          "status": {
            "enum": [
              "implemented",
              "partial",
              "missing",
              "n/a"
            ]
          },
          "components": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "description": "path or path:line of a test that proves it."
            }
          },
          "note": {
            "type": "string",
            "maxLength": 160,
            "description": "Required for partial and missing."
          }
        }
      }
    }
  }
}
